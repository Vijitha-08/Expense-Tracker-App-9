# Copy to .env and fill in real values. NEVER commit .env.

PORT=5000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_NAME=Expense_Tracker_App

# --- Auth ---
# Generate a real one, do not reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is shorter than 32 characters.
JWT_SECRET=replace_me_with_a_64_plus_character_random_hex_string
JWT_EXPIRES_IN=1d

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
