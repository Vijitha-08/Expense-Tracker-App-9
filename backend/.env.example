# Copy to .env and fill in real values. NEVER commit .env.

PORT=5000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_NAME=Expense_Tracker_App

# --- Auth ---
# Generate a real one, do not reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is shorter than 32 characters.
JWT_SECRET=replace_me_with_a_64_plus_character_random_hex_string
JWT_EXPIRES_IN=1d

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# ---- Email (password reset codes) ----
# Without these the reset flow still works, but the code is printed in the
# backend terminal instead of being emailed. Fill them in to send real email.
# Gmail: turn on 2-step verification, then create an App Password (16 chars)
# and use that as SMTP_PASS - your normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=Expense Tracker <youraddress@gmail.com>

# Where messages from the public "Contact Us" form are sent. Optional - it falls
# back to SMTP_USER, so the form works as soon as SMTP above is filled in. Set it
# when the inbox that should read those messages is not the account sending them.
# Messages are saved to the contact_messages table either way, so nothing is lost
# if this is wrong or if SMTP is not configured at all.
CONTACT_TO=youraddress@gmail.com
