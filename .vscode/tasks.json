{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Setup (run this once)",
      "detail": "Installs everything, asks for your Postgres password, creates the database",
      "type": "shell",
      "command": "npm run setup",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "focus": true }
    },
    {
      "label": "2. Run the app",
      "detail": "Starts the API and the app together on ports 5000 and 5173",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated", "focus": true }
    },
    {
      "label": "Reset the database",
      "detail": "WARNING: explicitly deletes all existing expenses and accounts",
      "type": "shell",
      "command": "npm run db:reset",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Lint frontend",
      "type": "shell",
      "command": "npm run lint",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Build frontend for production",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
