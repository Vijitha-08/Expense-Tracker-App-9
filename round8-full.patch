+   Both are DRAWER-ONLY - `display: none` here, switched on in the 720px block.
+   They are one DOM either way, so the desktop bar is untouched: an "OVERVIEW"
+   heading and a 38px pip in a 64px-tall bar would be clutter, and the bar
+   already hides the name at that width for room. Verified 0 differing pixels
+   across the user dashboard and settings pages at 1440, 1200 and 900px. */
+.dash .dash-nav-label {
+    display: none;
+    font-size: 10px;
+    font-weight: 800;
+    letter-spacing: .12em;
+    text-transform: uppercase;
+    color: var(--muted);
+    padding: 0 12px;
+    margin: 2px 0 8px;
+}
+.dash .dash-avatar {
+    display: none;
+    width: 38px;
+    height: 38px;
+    border-radius: var(--r-pill);
+    place-items: center;
+    background: var(--accent);
+    color: var(--on-accent);
+    font-size: 13.5px;
+    font-weight: 800;
+    letter-spacing: .02em;
+    flex: none;
+}
+
+/* ============================================================
+   SETTINGS ROWS, PICKERS AND SWITCHES
+   ------------------------------------------------------------
+   The user counterparts of `.adm-set-row`, `.adm-pick` and
+   `.adm-switch`. Same shapes, built on the user tokens, so the
+   two settings pages behave identically without `.dash` having
+   to import anything from `Admin.css`.
+   ============================================================ */
+.dash .dash-set-row {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 18px;
+    padding: 15px 0;
+    border-top: 1px solid var(--border);
+}
+.dash .dash-set-row:first-of-type { border-top: 0; }
+.dash .dash-set-txt { min-width: 0; }
+.dash .dash-set-txt b {
+    display: block;
+    font-size: 13.5px;
+    font-weight: 700;
+    color: var(--ink);
+}
+.dash .dash-set-txt small {
+    display: block;
+    margin-top: 3px;
+    font-size: 12.5px;
+    line-height: 1.5;
+    color: var(--muted);
+}
+
+.dash .dash-hint { font-size: 12px; color: var(--muted); }
+
+/* Segmented control. `inset` box-shadow rather than a border so the selected
+   button does not change size when it gains its outline - a 1px border on the
+   active item alone shifts every sibling by a pixel. */
+.dash .dash-pick {
+    display: inline-flex;
+    flex: none;
+    gap: 3px;
+    padding: 3px;
+    border-radius: var(--r-sm);
+    background: var(--page-alt);
+    box-shadow: inset 0 0 0 1px var(--border);
+}
+.dash .dash-pick button {
+    padding: 7px 12px;
+    min-height: 34px;
+    border: 0;
+    border-radius: calc(var(--r-sm) - 2px);
+    background: transparent;
+    font: inherit;
+    font-size: 12.5px;
+    font-weight: 650;
+    /* --ink-soft, not --muted: measured, --muted lands at 4.19:1 on the track's
+       --page-alt fill, under the 4.5 a 12.5px label needs. These are the
+       unselected options, not decoration - they have to be readable. */
+    color: var(--ink-soft);
+    cursor: pointer;
+    white-space: nowrap;
+}
+.dash .dash-pick button:hover { color: var(--ink); }
+.dash .dash-pick .dash-pick-on,
+.dash .dash-pick .dash-pick-on:hover {
+    background: var(--surface);
+    color: var(--accent);
+    box-shadow: 0 1px 2px var(--img-shadow);
+}
+
+/* A real <button role="switch">, not a checkbox: the state is announced by
+   aria-checked and the whole control is one tab stop. */
+.dash .dash-switch {
+    flex: none;
+    width: 46px;
+    height: 27px;
+    padding: 3px;
+    border: 0;
+    border-radius: 999px;
+    background: var(--border-strong);
+    cursor: pointer;
+    transition: background .16s ease;
+}
+.dash .dash-switch i {
+    display: block;
+    width: 21px;
+    height: 21px;
+    border-radius: 50%;
+    background: var(--surface);
+    box-shadow: 0 1px 3px var(--img-shadow);
+    transition: transform .16s ease;
+}
+.dash .dash-switch-on { background: var(--accent); }
+.dash .dash-switch-on i { transform: translateX(19px); }
+
+.dash .dash-note {
+    display: flex;
+    align-items: flex-start;
+    gap: 9px;
+    margin: 16px 0 0;
+    padding: 12px 14px;
+    border-radius: var(--r-sm);
+    background: var(--page-alt);
+    font-size: 12.5px;
+    line-height: 1.55;
+    color: var(--ink-soft);
+}
+.dash .dash-note svg { width: 15px; height: 15px; flex: none; margin-top: 1px; color: var(--muted); }
+
+.dash .btn-danger {
+    background: var(--bad-wash);
+    color: var(--bad);
+    border-color: var(--bad-line);
+}
+.dash .btn-danger:disabled { opacity: .6; cursor: not-allowed; }
+.dash .dash-danger { box-shadow: inset 0 0 0 1px var(--bad-line); }
+
+@media (prefers-reduced-motion: reduce) {
+    .dash .dash-switch,
+    .dash .dash-switch i { transition: none; }
+}
+
+/* Below 720px the links become a stacked menu at the top of the drawer, above
+   the identity block, with a rule under them - the reference layout the drawer
+   was built from. */
+@media (max-width: 720px) {
+    .dash .dash-side-panel .dash-nav {
+        flex-direction: column;
+        align-items: stretch;
+        gap: 2px;
+        padding-bottom: 12px;
+        margin-bottom: 12px;
+        border-bottom: 1px solid var(--border-strong);
+    }
+    .dash .dash-side-panel .dash-nav-link {
+        min-height: 44px;
+        padding: 0 12px;
+        font-size: 13.5px;
+    }
+    .dash .dash-side-panel .dash-nav-link svg { width: 17px; height: 17px; }
+    .dash .dash-side-panel .dash-nav-label { display: block; }
+
+    /* A settings row cannot stay a two-column row at 360px: the control ends up
+       beside a two-line label with about 90px to live in. */
+    .dash .dash-set-row {
+        flex-direction: column;
+        align-items: stretch;
+        gap: 12px;
+    }
+    .dash .dash-pick { align-self: stretch; }
+    .dash .dash-pick button { flex: 1; }
+    .dash .dash-set-row .dash-switch { align-self: flex-start; }
+}
+
+/* `.form-row` is `repeat(auto-fit, minmax(150px, 1fr))`, so it keeps two columns
+   down to a 312px content box - fine for the expense drawer's Title/Amount pair,
+   too tight on this page, where 150px cannot hold an email address or the words
+   "Confirm new password". Scoped to the settings forms so the drawer, which is
+   already signed off at these widths, is untouched. */
+@media (max-width: 620px) {
+    .dash .dash-set-form .form-row { grid-template-columns: minmax(0, 1fr); }
+}
